    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "17.2.3",
    "next": "15.5.14",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "prisma": "^6.12.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
